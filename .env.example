# =====================================================================
# Cognevance Technologies - Student Management System
# Environment Configuration Template (.env.example)
# Copy this file to .env (do not commit .env to source control)
# =====================================================================

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_management_db
DB_USERNAME=student_admin
DB_PASSWORD=ChangeMeWithSecurePassword123!

# Spring Boot Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# CORS Allowed Origins (Comma separated for multiple)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend Vite Configuration
VITE_API_BASE_URL=http://localhost:8080/api
