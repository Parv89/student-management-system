#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper Unix Shell Script
# ----------------------------------------------------------------------------

WRAPPER_JAR="$(dirname "$0")/.mvn/wrapper/maven-wrapper.jar"
if [ ! -f "$WRAPPER_JAR" ]; then
    echo "[INFO] Downloading Maven Wrapper..."
    curl -s -f -o "$WRAPPER_JAR" https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar
fi

if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

exec "$JAVACMD" -Dmaven.multiModuleProjectDirectory="$(dirname "$0")" -cp "$WRAPPER_JAR" org.apache.maven.wrapper.MavenWrapperMain "$@"
